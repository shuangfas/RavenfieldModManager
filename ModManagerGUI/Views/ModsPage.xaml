<UserControl x:Class="ModManagerGUI.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ModManagerGUI.Views"
             xmlns:vm="clr-namespace:ModManagerGUI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <!-- 卡片容器：圆角、悬浮/选中高亮（对应 CardWidget + set_selected） -->
        <Style x:Key="ModCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,4,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Background="#14FFFFFF">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签弹窗公共资源：内容模板 + 可选中的胶囊样式（两组标签复用） -->
        <DataTemplate x:Key="TagItemTemplate">
            <TextBlock Text="{Binding}" FontSize="12" />
        </DataTemplate>
        <Style x:Key="TagItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="#22FFFFFF"
                                Padding="10,4"
                                Margin="0,0,8,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,10,18,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="55*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：排序/标签工具栏 + 模组卡片列表 -->
        <Grid Grid.Column="0" Margin="0,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{DynamicResource Top.LoadOrder}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               FontSize="12" Opacity="0.6" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding SortOptions}"
                              SelectedIndex="{Binding SelectedSortIndex}" />
                </StackPanel>
                
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ui:AutoSuggestBox Width="300"
                                       PlaceholderText="{DynamicResource Left.SearchPlaceholder}"
                                       Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button x:Name="TagsButton"
                               Margin="8,0,0,0"
                               Width="36"
                               Height="36"
                               Appearance="Transparent"
                               Click="TagsButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Tag24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <Popup x:Name="TagsPopup"
                       PlacementTarget="{Binding ElementName=TagsButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#E61C1C1C"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,4,0,0"
                            MaxWidth="360">
                        <DockPanel>
                            <!-- 匹配模式开关：关 = AND（需命中全部标签），开 = OR（任一命中） -->
                            <ui:ToggleSwitch DockPanel.Dock="Bottom"
                                             HorizontalAlignment="Right"
                                             Margin="0,8,0,0"
                                             IsChecked="{Binding MatchAnyTag}"
                                             OnContent="OR"
                                             OffContent="AND">
                            </ui:ToggleSwitch>
                            <StackPanel>
                                <TextBlock Text="ContentType" FontSize="12" Margin="0,0,0,4" />
                                <ListBox x:Name="ContentTypeTagsList"
                                         ItemsSource="{x:Static vm:ModsViewModel.CONTENT_TYPE_TAGS}"
                                         ItemTemplate="{StaticResource TagItemTemplate}"
                                         ItemContainerStyle="{StaticResource TagItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Multiple"
                                         SelectionChanged="TagsList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Text="MapTags" FontSize="12" Margin="0,4,0,4" />
                                <ListBox x:Name="MapTagsList"
                                         ItemsSource="{x:Static vm:ModsViewModel.MAP_TAGS}"
                                         ItemTemplate="{StaticResource TagItemTemplate}"
                                         ItemContainerStyle="{StaticResource TagItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Multiple"
                                         SelectionChanged="TagsList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>
            </DockPanel>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding ModsView}"
                     ItemContainerStyle="{StaticResource ModCardItemStyle}"
                     SelectedItem="{Binding SelectedMod}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModCardViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Width="64" Height="64">
                                <Image Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Source>
                                        <BitmapImage DecodePixelHeight="64" DecodePixelWidth="64"
                                                     UriSource="{Binding ImagePath}" />
                                    </Image.Source>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Id, StringFormat=ID {0}}"
                                           FontSize="11"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Separator Grid.Column="1" Background="White" Width="3" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                   Opacity="0.1">
        </Separator>
        <!-- 右栏：模组详情 -->
        <Grid Grid.Column="2" Margin="12,0,0,0">
            <Separator Background="White" Height="16" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       Opacity="0.1" Margin="0,12,0,0">
            </Separator>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:NavigationView Grid.Column="0" x:Name="DetailNavigation"
                                   PaneDisplayMode="Top"
                                   IsBackButtonVisible="Collapsed"
                                   IsPaneToggleVisible="False"
                                   Transition="SlideRight"
                                   Navigating="DetailNavigation_Navigating"
                                   Background="Transparent"
                                   Margin="0,-10,0,0"
                                   DockPanel.Dock="Left">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="{DynamicResource Right.Tab.ModDetail}"
                                               TargetPageType="{x:Type views:ModDetailPage}"
                                               NavigationCacheMode="Required"/>
                        <ui:NavigationViewItem Content="{DynamicResource Right.Tab.Content}"
                                               TargetPageType="{x:Type views:ModContentPage}"
                                               NavigationCacheMode="Required" />
                    </ui:NavigationView.MenuItems>
                </ui:NavigationView>
                <!-- "..." 下拉菜单（对应 RoundMenu：打开目录/工坊页面/复制 ID） -->
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Click="MoreButton_Click"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,-5,0,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    </ui:Button.Icon>
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Menu.OpenFolder}"
                                      Command="{Binding PlacementTarget.DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource Menu.WorkshopPage}"
                                      Command="{Binding PlacementTarget.DataContext.OpenWorkshopPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource Menu.CopyId}"
                                      Command="{Binding PlacementTarget.DataContext.CopyModIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>