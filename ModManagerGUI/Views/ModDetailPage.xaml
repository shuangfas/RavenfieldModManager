<Page x:Class="ModManagerGUI.Views.ModDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:wpf="clr-namespace:TheArtOfDev.HtmlRenderer.WPF;assembly=HtmlRenderer.WPF"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,25,0,0">
        
        <!-- 开启 HTML 渲染时显示 -->
        <wpf:HtmlPanel Text="{Binding DetailDescription}" Background="Transparent">
            <wpf:HtmlPanel.Style>
                <Style TargetType="{x:Type wpf:HtmlPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EnableHtmlRendering}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </wpf:HtmlPanel.Style>
        </wpf:HtmlPanel>
        <!-- 关闭 HTML 渲染时显示纯文本 -->
        <ScrollViewer VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EnableHtmlRendering}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <TextBlock Text="{Binding DetailDescription}"
                       TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</Page>