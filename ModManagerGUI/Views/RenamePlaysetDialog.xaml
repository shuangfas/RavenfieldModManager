<ui:FluentWindow x:Class="ModManagerGUI.Views.RenamePlaysetDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="{DynamicResource Playlist.NewPlaysetTitle}"
                 Width="400" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Playlist.NewPlaysetTitle}" />

        <ui:TextBox Grid.Row="1"
                    x:Name="NameBox"
                    Margin="0,8,0,4"
                    PlaceholderText="{DynamicResource Playlist.NamePlaceholder}"
                    KeyDown="NameBox_KeyDown" />

        <TextBlock Grid.Row="2"
                   x:Name="ErrorText"
                   Text="{DynamicResource Playlist.NameInvalid}"
                   FontSize="12"
                   Foreground="OrangeRed"
                   Margin="0,4,0,4"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="{DynamicResource Playlist.OK}"
                       Appearance="Primary"
                       Click="OkButton_Click" />
            <ui:Button Content="{DynamicResource Playlist.Cancel}"
                       Margin="12,0,0,0"
                       Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
