<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <PreserveCompilationReferences>true</PreserveCompilationReferences>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
        <PackageReference Include="HtmlRenderer.WPF" Version="1.6.1" />
        <PackageReference Include="MessageBoxGuo" Version="1.0.2.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
        <PackageReference Include="Newtonsoft.Json" Version="14.0.1-beta2" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="AssetStudio">
            <HintPath>libs\AssetStudio.dll</HintPath>
        </Reference>
        
    </ItemGroup>
    <ItemGroup>
      <Content Include="Assets\**\*">
          <CopyToPublishDirectory>Always</CopyToPublishDirectory>
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
